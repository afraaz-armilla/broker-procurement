# Copy to .env for local runs. In CI these are GitHub Actions secrets — never commit real values.

# LLM
ANTHROPIC_API_KEY=

# Path B lookup
APOLLO_API_KEY=
HUNTER_API_KEY=

# Email verification
ZEROBOUNCE_API_KEY=
ABSTRACT_API_KEY=

# CRM
HUBSPOT_PRIVATE_APP_TOKEN=

# Approval
SLACK_BOT_TOKEN=

# Google Sheets store + Drive sanctions archive
# Preferred: Workload Identity Federation (no long-lived key) — set these two only:
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT_EMAIL=
# Fallback, only if WIF isn't available in your GCP org:
GCP_SERVICE_ACCOUNT_KEY_B64=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# Optional Path A search upgrade (default provider is free RSS, no key needed)
BRAVE_SEARCH_API_KEY=
